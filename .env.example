# Copiá este archivo como .env para desarrollo local.
# En producción estas variables se cargan en Vercel (Settings → Environment Variables).

# URL del backend (local: http://localhost:3000)
VITE_API_URL=https://sheligo-backend.onrender.com

# Proyecto de Supabase (Settings → API). La clave anon es pública por diseño:
# la seguridad de los datos la dan las políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
